# Copy to .env and fill in. .env is gitignored and must never be committed.

# Personal access token. Public repository read access is sufficient.
# Leave blank to run unauthenticated (60 requests/hour instead of 5,000 —
# useful for exercising the rate-limit path deliberately).
GITHUB_TOKEN=

# API root. Overridable for GitHub Enterprise.
GITHUB_API_URL=https://api.github.com

# Target repository, owner/name.
TARGET_REPO=dbt-labs/dbt-core

# Items per page. GitHub's maximum is 100; the default if unset is 30.
PER_PAGE=100

# Development cap on pages fetched. Blank means fetch to exhaustion.
MAX_PAGES=3

# How far back to pull, in months.
SINCE_MONTHS=12

LOG_LEVEL=INFO
